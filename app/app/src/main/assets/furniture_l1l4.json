    "finding": {
      "summary": "安床宜择宅之吉方吉间，合本人生位；床安在命卦凶方（绝命/五鬼/六煞/祸害）则不利安寝、损福。",
      "remedy": [
        "将床移至命卦吉方（生气/延年/天乙/伏位）",
        "无法移动时以屏风、帐幔遮挡凶方一侧"
      ]
    },
    "evidence": [
      {
        "book": "宅法举隅",
        "chapter": "卧房",
        "quoteKey": "zfj_bed_01",
        "original": "安床，宜擇宅之吉方吉間，房門，又宜得間星之生旺，合床之生位",
        "modern": "安床应选宅中吉方吉间，并配合本命生旺之星位，与床的生位相合。",
        "reliability": "直接明确"
      }
    ]
  },
